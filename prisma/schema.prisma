generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  employeePrefix String     @default("BKP-")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  employees Employee[]
}

model Employee {
  id             String         @id @default(cuid())
  tenantId       String
  
  // 1. IDENTITAS UTAMA
  employeeNumber String
  fullName       String
  email          String
  phoneNumber    String?
  joinDate       DateTime
  status         EmployeeStatus @default(ACTIVE)
  
  // 2. DATA PRIBADI
  birthDate      DateTime?
  birthPlace     String?
  gender         String?
  religion       String?
  maritalStatus  String?        // Rumusan Pajak (TK/0, K/1)
  motherName     String?
  spouseName     String?
  childrenCount  Int?           @default(0)
  
  // 3. IDENTITAS & ALAMAT
  ktpNumber      String?
  npwpNumber     String?
  jamsostekNumber String?
  address        String?
  
  // 4. KEPEGAWAIAN & PENEMPATAN
  department     String
  position       String
  education      String?
  customer       String?
  branchCode     String?
  outlet         String?
  
  // 5. KONTRAK & KELUAR
  contractStart  DateTime?
  contractEnd    DateTime?
  contractNumber String?
  exitDate       DateTime?

  // 6. FINANSIAL
  bankName       String?
  bankAccount    String?
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, email])
  @@index([tenantId])
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- MODEL UTAMA ---

model Tenant {
  id             String     @id @default(cuid())
  name           String
  employeePrefix String     @default("BKP-")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  employees      Employee[]
  attendances Attendance[]
}

model Employee {
  id             String         @id @default(cuid())
  tenantId       String
  
  // 1. IDENTITAS UTAMA
  employeeNumber String
  oldEmployeeNumber String?
  fullName       String
  email          String
  phoneNumber    String?
  joinDate       DateTime
  status         EmployeeStatus @default(ACTIVE)
  
  // 2. DATA PRIBADI
  birthDate      DateTime?
  birthPlace     String?
  gender         String?
  religion       String?
  maritalStatus  String?        
  motherName     String?
  spouseName     String?
  childrenCount  Int?           @default(0)
  
  // 3. IDENTITAS & ALAMAT
  ktpNumber      String?
  npwpNumber     String?
  jamsostekNumber String?
  address        String?
  
  // 4. KEPEGAWAIAN & PENEMPATAN
  department     String
  position       String
  education      String?
  customer       String?
  branchCode     String?
  outlet         String?
  
  // 5. KONTRAK & KELUAR
  contractStart  DateTime?
  contractEnd    DateTime?
  contractNumber String?
  exitDate       DateTime?

  // 6. FINANSIAL
  bankName       String?
  bankAccount    String?
  
  // 7. AUTENTIKASI & HAK AKSES
  password       String?
  roleId         String?
  role           Role?          @relation(fields: [roleId], references: [id])
  permissions    Permission[]
  attendances Attendance[]
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([fullName])       // <-- Tambahan Index untuk performa pencarian
  @@index([employeeNumber]) // <-- Tambahan Index untuk performa pencarian
}

// --- MODEL KATEGORI (Label Saja) ---

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now())
}

// --- MODEL HAK AKSES ---

model Permission {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  employees   Employee[] // Relasi balik dari Employee
}

// --- MODEL ABSENSI ---

model Attendance {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  date        DateTime @db.Date // Menyimpan tanggal (YYYY-MM-DD) untuk cek duplikat harian
  checkIn     DateTime? // Jam masuk
  checkOut    DateTime? // Jam keluar
  status      String   @default("PRESENT") // "PRESENT", "LATE", "ABSENT", "LEAVE"
  notes       String?  // Catatan
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Constraint: Satu karyawan hanya boleh punya 1 absensi per hari
  @@unique([employeeId, date])
  @@index([tenantId, date])
  @@index([employeeId])
}

// --- ENUM ---

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}
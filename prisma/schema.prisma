generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- MODEL UTAMA ---

model Tenant {
  id             String     @id @default(cuid())
  name           String
  employeePrefix String     @default("BKP-")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  
  employees      Employee[]
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  additionalIncomes AdditionalIncome[]
}

model Employee {
  id             String         @id @default(cuid())
  tenantId       String
  
  // 1. IDENTITAS UTAMA
  employeeNumber String
  oldEmployeeNumber String?
  fullName       String
  email          String
  phoneNumber    String?
  joinDate       DateTime
  status         EmployeeStatus @default(ACTIVE)
  
  // 2. DATA PRIBADI
  birthDate      DateTime?
  birthPlace     String?
  gender         String?
  religion       String?
  maritalStatus  String?        
  motherName     String?
  spouseName     String?
  childrenCount  Int?           @default(0)
  
  // 3. IDENTITAS & ALAMAT
  ktpNumber      String?
  npwpNumber     String?
  jamsostekNumber String?
  address        String?
  
  // 4. KEPEGAWAIAN & PENEMPATAN
  department     String
  position       String
  education      String?
  customer       String?
  branchCode     String?
  outlet         String?
  
  // 5. KONTRAK & KELUAR
  contractStart  DateTime?
  contractEnd    DateTime?
  contractNumber String?
  exitDate       DateTime?

  // 6. FINANSIAL
  bankName       String?
  bankAccount    String?
  
  // 7. AUTENTIKASI & HAK AKSES
  password       String?
  roleId         String?
  role           Role?          @relation(fields: [roleId], references: [id])
  permissions    Permission[]
  attendances    Attendance[]
  
  // Relasi Cuti & Persetujuan
  leaveRequests  LeaveRequest[] @relation("EmployeeLeaves")
  approvals      ApprovalStep[] @relation("ApproverSteps")
  leaveBalances  LeaveBalance[]
  additionalIncomes AdditionalIncome[]
  
  // Relasi AmArea (Wilayah kerja AM)
  amAreas        AmArea[]       @relation("AmAssignments")
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([fullName])
  @@index([employeeNumber])
}

// --- MODEL WILAYAH KERJA AM ---

model AmArea {
  id          String   @id @default(cuid())
  tenantId    String
  amId        String
  branchCode  String
  
  am          Employee @relation("AmAssignments", fields: [amId], references: [id], onDelete: Cascade)
  
  @@unique([amId, branchCode])
}

// --- MODEL KATEGORI (Label Saja) ---

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now())
}

// --- MODEL HAK AKSES ---

model Permission {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  employees   Employee[]
}

// --- MODEL ABSENSI ---

model Attendance {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  date        DateTime @db.Date 
  checkIn     DateTime? 
  checkOut    DateTime? 
  status      String   @default("PRESENT") 
  notes       String?  
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId, date])
  @@index([employeeId])
}

// --- MODEL CUTI & IZIN ---

model LeaveRequest {
  id             String   @id @default(cuid())
  tenantId       String
  employeeId     String
  type           String   // "CUTI", "IZIN", "SAKIT"
  startDate      DateTime
  endDate        DateTime
  totalDays      Int
  reason         String?
  attachmentUrl  String?
  status         String   @default("PENDING")
  
  relieverId     String?  
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee @relation("EmployeeLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  approvals      ApprovalStep[]
  relieverAssignment RelieverAssignment?
}

model ApprovalStep {
  id             String   @id @default(cuid())
  leaveRequestId String
  approverId     String
  role           String   // "AM", "HC", "MANAGER"
  status         String   @default("WAITING")
  notes          String?
  approvedAt     DateTime?
  
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approver       Employee     @relation("ApproverSteps", fields: [approverId], references: [id], onDelete: Cascade)
}

model LeaveBalance {
  id          String   @id @default(cuid())
  employeeId  String
  year        Int
  quota       Int      @default(0)
  used        Int      @default(0)
  isMinus     Boolean  @default(false)
  
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  @@unique([employeeId, year])
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// --- MODEL RELIEVER (TENAGA PENGGANTI) ---

model Reliever {
  id          String   @id @default(cuid())
  tenantId    String
  fullName    String
  ktpNumber   String?
  phoneNumber String?
  email       String?  // Untuk pengiriman link absensi
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments RelieverAssignment[]
  
  @@index([tenantId])
}

model RelieverAssignment {
  id             String   @id @default(cuid())
  tenantId       String
  leaveRequestId String   @unique // Satu pengajuan cuti hanya bisa 1 reliever
  relieverId     String
  date           DateTime // Tanggal penggantian
  // Token unik untuk link absensi
  uniqueToken    String   @unique @default(cuid())

  // Data absensi reliever (diisi nanti)
  checkIn        DateTime?
  checkOut       DateTime?
  selfieUrl      String?
  lat            Float?
  lng            Float?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reliever       Reliever     @relation(fields: [relieverId], references: [id], onDelete: Cascade)
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
}

model AdditionalIncome {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  type        String
  date        DateTime
  amount      Float
  description String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
}

// --- ENUM ---

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}
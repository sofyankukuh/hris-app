generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- MODEL UTAMA ---

model Tenant {
  id             String     @id @default(cuid())
  name           String
  employeePrefix String     @default("BKP-")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  
  employees        Employee[]
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  additionalIncomes AdditionalIncome[]
  resignations     Resignation[]
  businessTrips    BusinessTrip[]
  payrolls         Payroll[]
  salaryTemplates  SalaryTemplate[]
  payrollBatches   PayrollBatch[] // <-- TAMBAHAN
}

model Employee {
  id             String         @id @default(cuid())
  tenantId       String
  
  // 1. IDENTITAS UTAMA
  employeeNumber String
  oldEmployeeNumber String?
  fullName       String
  email          String
  phoneNumber    String?
  joinDate       DateTime
  status         EmployeeStatus @default(ACTIVE)
  
  // 2. DATA PRIBADI
  birthDate      DateTime?
  birthPlace     String?
  gender         String?
  religion       String?
  maritalStatus  String?        
  motherName     String?
  spouseName     String?
  childrenCount  Int?           @default(0)
  
  // 3. IDENTITAS & ALAMAT
  ktpNumber      String?
  npwpNumber     String?
  jamsostekNumber String?
  address        String?
  
  // 4. KEPEGAWAIAN & PENEMPATAN
  department     String
  position       String
  education      String?
  customer       String?
  branchCode     String?
  outlet         String?
  
  // 5. KONTRAK & KELUAR
  contractStart  DateTime?
  contractEnd    DateTime?
  contractNumber String?
  exitDate       DateTime?

  // 6. FINANSIAL
  bankName       String?
  bankAccount    String?
  
  // 7. AUTENTIKASI & HAK AKSES
  password       String?
  roleId         String?
  role           Role?          @relation(fields: [roleId], references: [id])
  permissions    Permission[]
  attendances    Attendance[]
  
  // Relasi Cuti & Persetujuan
  leaveRequests  LeaveRequest[] @relation("EmployeeLeaves")
  approvals      ApprovalStep[] @relation("ApproverSteps")
  leaveBalances  LeaveBalance[]
  additionalIncomes AdditionalIncome[]
  resignations   Resignation[]
  resignationApprovals ResignationApproval[] @relation("ResignationApprovals")
  businessTrips   BusinessTrip[]
  businessTripApprovals BusinessTripApproval[] @relation("BusinessTripApprovals")
  
  // Relasi Payroll
  salaryConfigs  EmployeeSalaryConfig[]
  salaryMasters  EmployeeSalaryMaster[]
  payrolls       Payroll[]
  salaryTemplate EmployeeSalaryTemplate?
  
  // Relasi AmArea
  amAreas        AmArea[]       @relation("AmAssignments")
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([fullName])
  @@index([employeeNumber])
}

// --- MODEL WILAYAH KERJA AM ---

model AmArea {
  id          String   @id @default(cuid())
  tenantId    String
  amId        String
  branchCode  String
  
  am          Employee @relation("AmAssignments", fields: [amId], references: [id], onDelete: Cascade)
  
  @@unique([amId, branchCode])
}

// --- MODEL KATEGORI (Label Saja) ---

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now())
}

// --- MODEL HAK AKSES ---

model Permission {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  employees   Employee[]
}

// --- MODEL ABSENSI ---

model Attendance {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  date        DateTime @db.Date 
  checkIn     DateTime? 
  checkOut    DateTime? 
  status      String   @default("PRESENT") 
  notes       String?  
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId, date])
  @@index([employeeId])
}

// --- MODEL CUTI & IZIN ---

model LeaveRequest {
  id             String   @id @default(cuid())
  tenantId       String
  employeeId     String
  type           String   // "CUTI", "IZIN", "SAKIT"
  startDate      DateTime
  endDate        DateTime
  totalDays      Int
  reason         String?
  attachmentUrl  String?
  status         String   @default("PENDING")
  
  relieverId     String?  
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee @relation("EmployeeLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  approvals      ApprovalStep[]
  relieverAssignment RelieverAssignment?
}

model ApprovalStep {
  id             String   @id @default(cuid())
  leaveRequestId String
  approverId     String
  role           String   // "AM", "HC", "MANAGER"
  status         String   @default("WAITING")
  notes          String?
  approvedAt     DateTime?
  
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approver       Employee     @relation("ApproverSteps", fields: [approverId], references: [id], onDelete: Cascade)
}

model LeaveBalance {
  id          String   @id @default(cuid())
  employeeId  String
  year        Int
  quota       Int      @default(0)
  used        Int      @default(0)
  isMinus     Boolean  @default(false)
  
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  @@unique([employeeId, year])
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// --- MODEL RELIEVER (TENAGA PENGGANTI) ---

model Reliever {
  id          String   @id @default(cuid())
  tenantId    String
  fullName    String
  ktpNumber   String?
  phoneNumber String?
  email       String? 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments RelieverAssignment[]
  
  @@index([tenantId])
}

model RelieverAssignment {
  id             String   @id @default(cuid())
  tenantId       String
  leaveRequestId String   @unique 
  relieverId     String
  date           DateTime 
  uniqueToken    String   @unique @default(cuid())

  checkIn        DateTime?
  checkOut       DateTime?
  selfieUrl      String?
  lat            Float?
  lng            Float?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reliever       Reliever     @relation(fields: [relieverId], references: [id], onDelete: Cascade)
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
}

model AdditionalIncome {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  type        String
  date        DateTime
  amount      Float
  description String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
}

// --- MODEL RESIGN ---

model Resignation {
  id             String   @id @default(cuid())
  tenantId       String
  employeeId     String
  resignDate     DateTime 
  reason         String?
  attachmentUrl  String?
  status         String   @default("PENDING") 
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvals      ResignationApproval[]

  @@index([tenantId])
}

model ResignationApproval {
  id             String   @id @default(cuid())
  resignationId  String
  approverId     String
  role           String   
  status         String   @default("WAITING") 
  notes          String?
  approvedAt     DateTime?
  
  resignation    Resignation @relation(fields: [resignationId], references: [id], onDelete: Cascade)
  approver       Employee    @relation("ResignationApprovals", fields: [approverId], references: [id], onDelete: Cascade)
}

// --- MODEL SURAT PERJALANAN DINAS (SPD) ---

model BusinessTrip {
  id             String   @id @default(cuid())
  tenantId       String
  employeeId     String
  destination    String   
  startDate      DateTime
  endDate        DateTime
  purpose        String   
  status         String   @default("PENDING") 
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvals      BusinessTripApproval[]

  @@index([tenantId])
}

model BusinessTripApproval {
  id             String   @id @default(cuid())
  businessTripId String
  approverId     String
  role           String   
  status         String   @default("WAITING") 
  notes          String?
  approvedAt     DateTime?
  
  businessTrip   BusinessTrip @relation(fields: [businessTripId], references: [id], onDelete: Cascade)
  approver       Employee     @relation("BusinessTripApprovals", fields: [approverId], references: [id], onDelete: Cascade)
}

// --- MODEL PAYROLL (PARAMETER & HASIL) ---

model SalaryComponent {
  id          String   @id @default(cuid())
  name        String   @unique 
  type        String   // "EARNING" atau "DEDUCTION"
  createdAt   DateTime @default(now())
  
  employeeConfigs EmployeeSalaryConfig[]
  employeeMasters EmployeeSalaryMaster[]
  templateDetails SalaryTemplateDetail[] 
}

model EmployeeSalaryConfig {
  id                String   @id @default(cuid())
  employeeId        String
  salaryComponentId String
  isActive          Boolean  @default(true)
  
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryComponent   SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Cascade)
  
  @@unique([employeeId, salaryComponentId])
}

model EmployeeSalaryMaster {
  id                String   @id @default(cuid())
  employeeId        String
  salaryComponentId String
  amount            Float    
  
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryComponent   SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Cascade)
  
  @@unique([employeeId, salaryComponentId])
}

model Payroll {
  id             String   @id @default(cuid())
  tenantId       String
  employeeId     String
  month          Int      
  year           Int      
  
  basicSalary    Float    @default(0)
  totalEarnings  Float    @default(0) 
  totalDeductions Float   @default(0) 
  netSalary      Float    @default(0) 
  
  status         String   @default("DRAFT")
  notes          String?
  
  batchId        String?
  batch          PayrollBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([tenantId, year, month])
}

// --- MODEL TEMPLATE PARAMETER GAJI ---

model SalaryTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   
  description String?
  createdAt   DateTime @default(now())
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  details     SalaryTemplateDetail[]
  employees   EmployeeSalaryTemplate[]
}

model SalaryTemplateDetail {
  id                String   @id @default(cuid())
  salaryTemplateId  String
  salaryComponentId String
  isActive          Boolean  @default(true)
  
  salaryTemplate    SalaryTemplate @relation(fields: [salaryTemplateId], references: [id], onDelete: Cascade)
  salaryComponent   SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Cascade)
  
  @@unique([salaryTemplateId, salaryComponentId])
}

model EmployeeSalaryTemplate {
  id                String   @id @default(cuid())
  employeeId        String   @unique
  salaryTemplateId  String
  
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryTemplate    SalaryTemplate @relation(fields: [salaryTemplateId], references: [id], onDelete: Cascade)
}

// --- MODEL BATCH PAYROLL ---

model PayrollBatch {
  id          String   @id @default(cuid())
  tenantId    String
  periodMonth Int
  periodYear  Int
  cutOffStart DateTime
  cutOffEnd   DateTime
  createdAt   DateTime @default(now())
  
  payrolls    Payroll[]

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
}

// --- ENUM ---

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}
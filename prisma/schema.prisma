generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  employeePrefix String     @default("BKP-")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  employees Employee[]
}

model Employee {
  id             String         @id @default(cuid())
  tenantId       String
  
  // 1. IDENTITAS UTAMA
  employeeNumber String         // NIK (Otomatis BKP-)
  fullName       String
  email          String
  phoneNumber    String?
  joinDate       DateTime
  status         EmployeeStatus @default(ACTIVE)
  
  // 2. DATA PRIBADI
  birthDate      DateTime?
  birthPlace     String?
  gender         String?        // L / P
  religion       String?        // Islam, Kristen, dll
  maritalStatus  String?        // TK/0, K/1, dll (Rumusan Pajak)
  motherName     String?        // Nama Ibu
  spouseName     String?        // Nama Suami/Istri
  childrenCount  Int?           @default(0)
  
  // 3. IDENTITAS & ALAMAT
  ktpNumber      String?        // No KTP
  npwpNumber     String?        // No NPWP
  jamsostekNumber String?       // No BPJS
  address        String?        // Alamat Lengkap
  
  // 4. DATA KEPEGAWAIAN
  department     String
  position       String
  education      String?        // Pendidikan (S1, SMA, dll)
  customer       String?        // Customer (Produk/Service)
  branchCode     String?        // K. Cabang
  outlet         String?        // Outlet
  
  // 5. DATA KONTRAK
  contractStart  DateTime?
  contractEnd    DateTime?
  contractNumber String?
  exitDate       DateTime?      // Tgl Keluar

  // 6. DATA FINANSIAL
  bankName       String?
  bankAccount    String?
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, email])
  @@index([tenantId])
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}